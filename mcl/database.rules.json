{
  "rules": {
    "tournament": {
      ".read": true,
      "availability":    { ".write": true },
      "scheduled_games": { ".write": true },
      "audit_log":       { ".write": true },
      "upcoming":        { ".write": true },
      "matches":         { ".write": false },
      "groups":          { ".write": false },
      "team_codes":      { ".write": false }
    },
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "mcl_s2": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "availability":    { ".write": true },
      "scheduled_games": { ".write": true },
      "audit_log":       { ".write": true },
      "upcoming":        { ".write": true }
    }
  }
}
